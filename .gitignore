# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore everything inside the data directory
src-tauri/data/export/*
src-tauri/data/user/*
!src-tauri/data/user/placeholder

# Card images are extracted from Warframe cache at runtime (140+ MB)
src-tauri/data/assets/card-images/

src-tauri/data/bin/*
!src-tauri/data/bin/*.png
!src-tauri/data/bin/pricer-models/
!src-tauri/data/bin/pricer-models/**
!src-tauri/data/bin/warframe-api-helper*

# Python cache in training pipeline
__pycache__/
*.pyc

# Ignore target and Cargo.lock
src-tauri/target/
src-tauri/Cargo.lock

# C++ build artifacts
build_int/
build_int_win/
build_int_linux/

# Soup submodule content (git tracks it via .gitmodules, no need to index)
lib/soup/
*.obj

# Tauri v2 generated schemas (auto-generated, do not commit)
src-tauri/gen/
