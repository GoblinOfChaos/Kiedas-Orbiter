new file mode 100644
index 0000000..3c5b491
--- /dev/null
+++ b/src/components/PreviewImport.jsx
@@ -0,0 +1,65 @@
+import { useState, useRef, useEffect } from 'react';
+import { open } from '@tauri-apps/plugin-dialog';
+import { invoke } from '@tauri-apps/api/core';
+export default function PreviewImport() {
+  const dialog = useRef(null);
+  const opener = useRef(null);
+  const [visible, setVisible] = useState(false);
+  const [source, setSource] = useState('');
+  const [categories, setCategories] = useState(['inventory', 'notes', 'maps']);
+  const [replace, setReplace] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const busyRef = useRef(false);
+  busyRef.current = busy;
+  const [message, setMessage] = useState('');
+  const [done, setDone] = useState(false);
+  useEffect(() => {
+    if (!visible) return;
+    function handleKey(event) {
+      if (event.key === 'Escape' && !busyRef.current) { event.preventDefault(); setVisible(false); }
+      if (event.key !== 'Tab') return;
+      const controls = Array.from(dialog.current?.querySelectorAll('button:not(:disabled), input:not(:disabled), [tabindex="0"]') || []);
+      if (!controls.length) { event.preventDefault(); return; }
+      const first = controls[0], last = controls[controls.length - 1];
+      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
+      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
+    }
+    document.addEventListener('keydown', handleKey);
+    return () => { document.removeEventListener('keydown', handleKey); opener.current?.focus(); };
+  }, [visible]);
+  async function browse() {
+    try { const path = await open({ directory: true, multiple: false, title: 'Choose the source data/user folder' }); if (path) setSource(path); }
+    catch (error) { setMessage(String(error)); }
+  }
+  async function importCopy() {
+    setBusy(true); setMessage('');
+    try {
+      const result = await invoke('import_preview_profile', { source, categories, replace });
+      setMessage(result); setDone(true);
+    } catch (error) { setMessage(String(error)); }
+    finally { setBusy(false); }
+  }
+  return <div className="p-2 border-t border-white/10">
+    <button ref={opener} onClick={() => setVisible(true)} className="w-full rounded border border-kronos-accent/40 text-kronos-accent text-sm py-2">Import a profile copy</button>
+    {visible && <div className="fixed inset-0 z-[200] bg-black/70 flex items-center justify-center p-4">
+      <section ref={dialog} role="dialog" aria-modal="true" aria-labelledby="preview-import-title" className="bg-kronos-panel border border-white/20 rounded-xl p-5 max-w-lg w-full text-kronos-text">
+        <h2 id="preview-import-title" className="font-semibold text-lg">Import into Preview</h2>
+        <p className="text-sm text-kronos-dim my-3">Copies selected content from a data/user folder. Credentials and live integration settings are excluded. The source is never changed.</p>
+        <button autoFocus disabled={busy || done} onClick={browse} className="border rounded p-2 text-sm">Choose source folder</button>
+        <p className="text-xs my-2 break-all">{source || 'No folder selected'}</p>
+        <fieldset disabled={busy || done} className="space-y-2 my-3">
+          {['inventory', 'notes', 'maps', 'preferences', 'history', 'checklist'].map(name => <label key={name} className="flex gap-2 text-sm">
+            <input type="checkbox" checked={categories.includes(name)} onChange={e => setCategories(e.target.checked ? [...categories, name] : categories.filter(x => x !== name))} />{name}
+          </label>)}
+          <label className="flex gap-2 text-sm"><input type="checkbox" checked={replace} onChange={e => setReplace(e.target.checked)} />Replace selected existing Preview files, retaining a backup</label>
+        </fieldset>
+        <p className="text-xs text-kronos-dim">Checklist requires an explicit checklist-export.json file; browser storage is never read from the stable app.</p>
+        <p role="status" className="text-sm my-3 break-words">{message}</p>
+        <div className="flex justify-end gap-3">
+          <button disabled={busy} onClick={() => setVisible(false)} className="border rounded px-3 py-2">Close</button>
+          {done ? <button onClick={() => window.location.reload()} className="bg-kronos-accent text-black rounded px-3 py-2">Reload Preview</button> : <button disabled={busy || !source || !categories.length} onClick={importCopy} className="bg-kronos-accent text-black rounded px-3 py-2 disabled:opacity-40">{busy ? 'Copying…' : 'Import selected'}</button>}
+        </div>
+      </section>
+    </div>}
+  </div>;
+}
diff --git a/src/components/PreviewNavigation.jsx b/src/components/PreviewNavigation.jsx
new file mode 100644
index 0000000..80d8f53
--- /dev/null
+++ b/src/components/PreviewNavigation.jsx
@@ -0,0 +1,68 @@
+import { useState } from 'react';
+import { ChevronDown, ChevronRight, Star } from 'lucide-react';
+import PreviewImport from './PreviewImport';
+
+export const NAV_GROUPS = [
+  ['Today', ['dashboard']],
+  ['Collection', ['inventory', 'mastery', 'mods', 'cosmetics', 'collectibles']],
+  ['Planning', ['foundry', 'relics', 'relic-planner', 'prime-resurgence']],
+  ['Trading', ['market', 'rivens']],
+  ['Journal & Tools', ['history', 'adversaries', 'maps', 'wiki', 'notes', 'checklist']],
+  ['Application', ['settings', 'about']],
+];
+const KEY = 'preview.navigation.v1';
+function initialState() {
+  try {
+    const saved = JSON.parse(localStorage.getItem(KEY));
+    return { collapsed: saved?.collapsed && typeof saved.collapsed === 'object' ? saved.collapsed : {}, favorites: Array.isArray(saved?.favorites) ? saved.favorites.filter(id => typeof id === 'string') : [] };
+  } catch { return { collapsed: {}, favorites: [] }; }
+}
+export default function PreviewNavigation({ items, activeTab, onNavigate, uiIcon, t }) {
+  const [state, setState] = useState(initialState);
+  const [storageError, setStorageError] = useState('');
+  const byId = new Map(items.map(item => [item.id, item]));
+  function update(next) {
+    setState(next);
+    try { localStorage.setItem(KEY, JSON.stringify(next)); setStorageError(''); }
+    catch { setStorageError('Navigation preferences could not be saved.'); }
+  }
+  function row(id, favorite = false) {
+    const item = byId.get(id);
+    if (!item) return null;
+    const active = id === activeTab;
+    const translated = t(`nav.${id}`);
+    const label = translated === `nav.${id}` ? item.label : translated;
+    const pinned = state.favorites.includes(id);
+    return <div key={id} className="flex items-center gap-1">
+      <button aria-current={active ? 'page' : undefined} id={!favorite && id === 'settings' ? 'nav-settings' : undefined}
+        onClick={() => onNavigate(id)} className={`min-w-0 flex-1 flex items-center gap-2 px-2 py-2 rounded-lg text-left text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-kronos-accent ${active ? 'bg-kronos-accent/15 text-kronos-accent' : 'text-kronos-dim hover:bg-white/5 hover:text-kronos-text'}`}>
+        {item.lucide ? <item.lucide size={18} className="shrink-0" /> : <img alt="" src={uiIcon(item.icon)} className="w-[18px] h-[18px] object-contain shrink-0" />}
+        <span className="break-words">{label}</span>
+      </button>
+      <button aria-label={`${pinned ? 'Unpin' : 'Pin'} ${label}`} aria-pressed={pinned}
+        onClick={() => update({ ...state, favorites: pinned ? state.favorites.filter(x => x !== id) : [...state.favorites, id] })}
+        className="p-1 rounded text-kronos-dim hover:text-kronos-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-kronos-accent">
+        <Star size={14} fill={pinned ? 'currentColor' : 'none'} />
+      </button>
+    </div>;
+  }
+  return <nav aria-label="Main navigation" className="w-52 shrink-0 h-full flex flex-col border-r border-white/10 bg-kronos-panel">
+    <div className="p-3 border-b border-white/10 flex items-center gap-2">
+      <img src={uiIcon('IconKieda.png')} alt="" className="w-8 h-8" />
+      <div className="text-sm font-semibold">Kieda's Orbiter <span className="block text-xs text-kronos-accent">PREVIEW</span></div>
+    </div>
+    <div className="p-3 text-xs text-kronos-dim border-b border-white/10">Isolated profile · Live integrations and app updates disabled</div>
+    <div className="flex-1 min-h-0 overflow-y-auto p-2 custom-scrollbar">
+      {state.favorites.some(id => byId.has(id)) && <section aria-label="Favorites" className="mb-3"><h2 className="text-xs text-kronos-accent px-2 py-1">Favorites</h2>{state.favorites.map(id => row(id, true))}</section>}
+      {NAV_GROUPS.map(([label, ids], index) => <section key={label} className="mb-2">
+        <button aria-expanded={!state.collapsed[label]} aria-controls={`preview-group-${index}`} onClick={() => update({ ...state, collapsed: { ...state.collapsed, [label]: !state.collapsed[label] } })}
+          className="w-full flex items-center gap-1 px-2 py-2 text-xs uppercase tracking-wide text-kronos-dim hover:text-kronos-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-kronos-accent">
+          {state.collapsed[label] ? <ChevronRight size={13} /> : <ChevronDown size={13} />}{label}
+        </button>
+        <div id={`preview-group-${index}`} hidden={!!state.collapsed[label]}>{ids.map(id => row(id))}</div>
+      </section>)}
+    </div>
+    {storageError && <p role="alert" className="text-xs p-2 text-amber-400">{storageError}</p>}
+    <PreviewImport />
+  </nav>;
+}
