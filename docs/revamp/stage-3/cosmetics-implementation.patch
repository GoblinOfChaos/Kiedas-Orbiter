+export default function PreviewCosmeticsLayout({ enabled, children }) {
+  if (!enabled) return children;
+
+  return (
+    <section
+      data-preview-cosmetics-layout
+      aria-label="Cosmetics collection"
+      className="preview-cosmetics-layout min-w-0"
+      style={{ containerType: 'inline-size', containerName: 'preview-cosmetics' }}
+    >
+      <style>{`
+        .preview-cosmetics-layout,
+        [data-preview-cosmetics-controls],
+        [data-preview-cosmetics-toolbar],
+        [data-preview-cosmetics-grid] {
+          min-width: 0;
+        }
+        [data-preview-cosmetics-toolbar] {
+          display: grid;
+          grid-template-columns: minmax(0, 1fr);
+          align-items: stretch;
+          gap: .75rem;
+        }
+        [data-preview-cosmetics-search] {
+          width: 100%;
+          max-width: none;
+          min-width: 0;
+        }
+        [data-preview-cosmetics-sort] {
+          width: fit-content;
+          max-width: 100%;
+          height: auto;
+          min-height: 36px;
+          overflow-x: auto;
+          scrollbar-width: thin;
+        }
+        .preview-cosmetics-kind-tabs,
+        .preview-cosmetics-ownership-tabs {
+          width: 100%;
+          min-width: 0;
+          flex-wrap: nowrap;
+          overflow-x: auto;
+          scrollbar-width: thin;
+        }
+        .preview-cosmetics-kind-tabs > button,
+        .preview-cosmetics-ownership-tabs > button {
+          flex-shrink: 0;
+        }
+        .preview-cosmetics-ownership-tabs {
+          width: fit-content;
+          max-width: 100%;
+        }
+        [data-preview-cosmetics-grid] {
+          width: 100%;
+        }
+        @container preview-cosmetics (min-width: 620px) {
+          [data-preview-cosmetics-toolbar] {
+            grid-template-columns: minmax(0, 1fr) auto;
+          }
+        }
+      `}</style>
+      {children}
+    </section>
+  );
+}
