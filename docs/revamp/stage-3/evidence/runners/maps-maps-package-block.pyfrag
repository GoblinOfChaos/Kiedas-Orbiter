 results['maps_checks'].append({'kind':'marker-edit-drag-delete-path-and-auto-path','state':editor_state,'path_off':path_off,'path_on':path_on,'drag_dispatched':drag,'deleted':deleted,'auto':auto_control,'pass':editor_state=={'within':True,'colors':8,'notes':True,'connection':True} and path_off and path_on and drag and deleted and auto_control.get('present') is True and auto_control.get('title')=='Auto-connect each new marker to the previous one'})
