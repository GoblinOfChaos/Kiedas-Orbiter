 js("document.querySelector('[title=\"Switch to raw terrain map\"]')?.click();[...document.querySelectorAll('[data-preview-maps-tabs] button')].find(b=>b.textContent.trim()==='Orb Vallis')?.click()");time.sleep(.4)
