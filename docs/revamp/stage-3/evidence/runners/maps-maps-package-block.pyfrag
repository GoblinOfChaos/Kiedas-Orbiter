 def map_geometry(width,height,panel):
  api('POST',prefix+'/window/rect',{'width':width,'height':height});time.sleep(.4)
  present=js("return !!document.querySelector('[data-preview-maps-config-panel]')")
  if present!=panel:js("document.querySelector('[title=\"Configurations\"]').click()");time.sleep(.3)
  return js("""const root=document.querySelector('[data-preview-maps-shell]'),canvas=root.querySelector('[data-preview-maps-canvas]'),panel=root.querySelector('[data-preview-maps-config-panel]'),rr=root.getBoundingClientRect(),cr=canvas.getBoundingClientRect(),pr=panel?.getBoundingClientRect();return {root:{left:rr.left,top:rr.top,right:rr.right,bottom:rr.bottom},canvas:{left:cr.left,top:cr.top,right:cr.right,bottom:cr.bottom},panel:pr?{left:pr.left,top:pr.top,right:pr.right,bottom:pr.bottom}:null,body:{client:document.body.clientWidth,scroll:document.body.scrollWidth},viewport:[innerWidth,innerHeight]};""")
 for width,height in [(1200,800),(900,500)]:
  state=map_geometry(width,height,False);contained=state['root']['left']>=0 and state['root']['right']<=width+1 and state['canvas']['left']>=0 and state['canvas']['right']<=width+1 and state['body']['scroll']<=state['body']['client']+1
  results['maps_checks'].append({'kind':'closed-layout-geometry','size':[width,height],'state':state,'pass':contained and state['panel'] is None})
 for width,height in [(1200,800),(900,500)]:
  state=map_geometry(width,height,True);p=state['panel'];contained=p and p['left']>=0 and p['top']>=0 and p['right']<=width+1 and p['bottom']<=height+1 and state['body']['scroll']<=state['body']['client']+1
  results['maps_checks'].append({'kind':'open-panel-geometry','size':[width,height],'state':state,'pass':bool(contained)})
