 results['maps_checks'].append({'kind':'pan-zoom-reset-and-clamp','before':transform_before,'zoom_after':zoom_after,'pan_after':pan_after,'pan_reset':pan_reset,'min_clamped':min_clamped,'reset':reset,'pass':zoom_after!=transform_before and pan_after!=zoom_after and pan_reset==transform_before and min_clamped==transform_before and reset==transform_before})
