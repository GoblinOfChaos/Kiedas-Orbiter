+export default function PreviewInventoryLayout({ stats, controls }) {
+  return (
+    <section
+      data-preview-inventory-layout
+      aria-label="Inventory controls"
+      className="preview-inventory-layout min-w-0"
+      style={{ containerType: 'inline-size', containerName: 'preview-inventory-controls' }}
+    >
+      <style>{`
+        .preview-inventory-layout { min-width: 0; }
+        .preview-inventory-stats {
+          overflow-x: auto;
+          padding-bottom: .25rem;
+          scrollbar-width: thin;
+        }
+        .preview-inventory-stats > div {
+          width: max-content;
+          min-width: 100%;
+          margin-left: 0;
+          padding-right: 0;
+        }
+        .preview-inventory-controls {
+          min-width: 0;
+        }
+        .preview-inventory-controls > div > div:first-child > div:first-child {
+          display: grid;
+          grid-template-columns: minmax(0, 1fr);
+          align-items: stretch;
+          gap: .75rem;
+        }
+        .preview-inventory-controls > div > div:first-child > div:first-child > div {
+          min-width: 0;
+        }
+        .preview-inventory-controls > div > div:first-child > div:first-child > div:not(:first-child) {
+          width: 100%;
+          height: auto;
+          min-height: 42px;
+          overflow-x: auto;
+          scrollbar-width: thin;
+        }
+        .preview-inventory-controls > div > div:first-child > div:first-child > div:not(:first-child) > div {
+          width: max-content;
+          min-width: 100%;
+        }
+        .preview-inventory-controls > div > div:first-child > div:nth-child(2) {
+          width: 100%;
+          min-width: 0;
+          flex-wrap: nowrap;
+          overflow-x: auto;
+          scrollbar-width: thin;
+        }
+        .preview-inventory-controls > div > div:first-child > div:nth-child(2) > button {
+          flex-shrink: 0;
+        }
+        .preview-inventory-category-scroll { min-width: 0; }
+        @container preview-inventory-controls (min-width: 740px) {
+          .preview-inventory-controls > div > div:first-child > div:first-child {
+            grid-template-columns: repeat(2, minmax(0, 1fr));
+          }
+          .preview-inventory-controls > div > div:first-child > div:first-child > div:first-child {
+            grid-column: 1 / -1;
+          }
+        }
+      `}</style>
+
+      {stats && (
+        <div className="preview-inventory-stats mb-3" aria-label="Account resources">
+          {stats}
+        </div>
+      )}
+      <div className="preview-inventory-controls">
+        <div className="preview-inventory-category-scroll">
+          {controls}
+        </div>
+      </div>
+    </section>
+  );
+}
