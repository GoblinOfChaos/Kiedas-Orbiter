+export default function PreviewModsLayout({ enabled, children }) {
+  if (!enabled) return children;
+
+  return (
+    <section
+      data-preview-mods-layout
+      aria-label="Mods collection"
+      className="preview-mods-layout min-w-0"
+      style={{ containerType: 'inline-size', containerName: 'preview-mods' }}
+    >
+      <style>{`
+        .preview-mods-layout,
+        [data-preview-mods-header],
+        [data-preview-mods-toolbar],
+        [data-preview-mods-categories-row],
+        [data-preview-mods-grid] {
+          min-width: 0;
+        }
+        [data-preview-mods-toolbar] {
+          display: grid;
+          grid-template-columns: minmax(0, 1fr);
+          align-items: stretch;
+          gap: .75rem;
+        }
+        [data-preview-mods-toolbar] > div {
+          min-width: 0;
+          width: 100%;
+        }
+        [data-preview-mods-sort],
+        [data-preview-mods-filters] {
+          height: auto;
+          min-height: 42px;
+          overflow-x: auto;
+          scrollbar-width: thin;
+        }
+        [data-preview-mods-sort] > div,
+        [data-preview-mods-filters] > div {
+          width: max-content;
+          min-width: 100%;
+        }
+        [data-preview-mods-categories-row] {
+          width: 100%;
+        }
+        [data-preview-mods-categories] {
+          width: 100%;
+          min-width: 0;
+          flex-wrap: nowrap;
+          overflow-x: auto;
+          scrollbar-width: thin;
+        }
+        [data-preview-mods-categories] > button {
+          flex-shrink: 0;
+        }
+        [data-preview-mod-card]:focus-visible {
+          outline: 2px solid rgb(var(--kronos-accent-rgb));
+          outline-offset: 3px;
+          border-radius: .75rem;
+        }
+        @container preview-mods (min-width: 760px) {
+          [data-preview-mods-toolbar] {
+            grid-template-columns: repeat(2, minmax(0, 1fr));
+          }
+          [data-preview-mods-search] {
+            grid-column: 1 / -1;
+          }
+        }
+      `}</style>
+      {children}
+    </section>
+  );
+}
