--- /dev/null
+++ b/src/preview/view-models/dashboardViewModel.js
@@ -0,0 +1,44 @@
+export const DASHBOARD_PROMOTED_CARD_IDS = ['fiss', 'baro', 'nightwave'];
+
+export const DASHBOARD_SECTIONS = [
+  { id: 'now', title: 'Now', cardIds: ['timers', 'alerts', 'arb', 'inf', 'fiss', 'inv'] },
+  { id: 'activities', title: 'Activities & rotations', cardIds: ['bounty', 'nightwave', 'sortie', 'hunt', 'arch', 'desc', 'circuit', '1999'] },
+  { id: 'news', title: 'News & offers', cardIds: ['baro', 'event', 'deal', 'sales', 'news'] },
+];
+
+export function createDashboardViewModel({ inventoryData, notificationHistory, lastUpdate }) {
+  const inventoryKnown = inventoryData !== undefined && inventoryData !== null;
+  const craftable = Array.isArray(inventoryData?.craftable) ? inventoryData.craftable : [];
+  const readyRecipes = inventoryKnown
+    ? craftable.filter((recipe) => recipe?.readyToCraft === true)
+    : null;
+  const sessionActivity = Array.isArray(notificationHistory) ? notificationHistory : [];
+
+  return {
+    targets: {
+      count: 0,
+      available: false,
+    },
+    foundry: {
+      known: inventoryKnown,
+      count: readyRecipes?.length ?? null,
+      items: (readyRecipes || []).slice(0, 2).map((recipe) => ({
+        id: recipe.uniqueName || recipe.resultType || recipe.bpName,
+        name: recipe.baseName || recipe.bpName || 'Unnamed recipe',
+        image: recipe.image || '',
+        blueprintCount: recipe.bpCount ?? 0,
+        ingredientCount: Array.isArray(recipe.ingredients) ? recipe.ingredients.length : 0,
+      })),
+    },
+    session: {
+      count: sessionActivity.length,
+      items: sessionActivity.slice(0, 3).map((entry, index) => ({
+        id: `${entry.notifId || 'activity'}-${entry.timestamp || index}`,
+        title: entry.title || 'Activity',
+        message: entry.message || '',
+        timestamp: entry.timestamp || null,
+      })),
+    },
+    lastUpdate: lastUpdate || null,
+  };
+}
