{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Cephalon Kronos",
    "version": "../package.json"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "notification": {
        "all": true
      },
      "dialog": {
        "all": true,
        "open": true
      },
      "protocol": {
        "asset": true,
        "assetScope": [
          "**"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      },
      "globalShortcut": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://api.warframe.market/*",
          "https://github.com/glowseeker/cephalon-kronos/*"
        ]
      }
    },
    "bundle": {
      "active": true,
      "targets": [
        "nsis",
        "dmg",
        "appimage"
      ],
      "identifier": "com.glowseeker.cephalonkronos",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "resources": [
        "data/bin/*",
        "data/export/*",
        "data/audio/*"
      ]
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/glowseeker/cephalon-kronos/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0MENFRTlENTZBMzgxRjIKUldUeWdhTlduZTRNOU1FWXlhbnhSdGNPcm9ZMXkxZFhVb3lBZGU4MitqUEhWRFNDNG5wcjN1dkYK"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Cephalon Kronos",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 500
      },
      {
        "label": "overlay-tr",
        "title": "Kronos Overlay",
        "width": 320,
        "height": 1,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true,
        "skipTaskbar": true,
        "url": "/?overlay=true",
        "acceptFirstMouse": true,
        "focus": false
      },
      {
        "label": "overlay-tl",
        "title": "Kronos Overlay",
        "width": 320,
